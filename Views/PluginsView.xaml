<UserControl x:Class="RUNE.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Plugins" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />
        <TextBlock Text="No plugins installed yet. The plugin/module system arrives in a later step - this screen already exists so it's ready to list them the moment it does."
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
