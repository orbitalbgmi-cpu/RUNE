<UserControl x:Class="RUNE.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Chat" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <ComboBox x:Name="ModelSelector" Grid.Column="1" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="Ember" />
                <ComboBoxItem Content="NOVA (soon)" IsEnabled="False" />
            </ComboBox>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessageList">
                    <TextBlock Text="RUNE isn't connected to a brain yet - this is just the chat frame."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" FontStyle="Italic" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,10,0">
                <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                         Padding="12,10" FontSize="14" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         KeyDown="InputBox_KeyDown" />
            </Border>

            <Button Grid.Column="1" Content="Send" Click="SendButton_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Padding="20,10" FontWeight="SemiBold" Cursor="Hand" />
        </Grid>
    </Grid>
</UserControl>
