<UserControl x:Class="RUNE.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20" />

        <TextBlock Text="Theme" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
        <TextBlock Text="Edit config/theme.json to customize colors, then restart RUNE."
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                   FontSize="12" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0"
                    Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}" />
        </StackPanel>

        <TextBlock Text="Modules" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
        <TextBlock Text="Future features (local AI, microphone, memory, vision...) will appear here as on/off switches once added in later steps."
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
</UserControl>
