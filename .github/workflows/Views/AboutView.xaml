<UserControl x:Class="RUNE.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="About RUNE" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16">
            RUNE is being built step by step, starting as an empty UI frame
            and gradually gaining a mind of its own - launching later as NOVA.
        </TextBlock>
        <TextBlock Text="Version 0.1 - Step 1: UI Frame" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>
</UserControl>
